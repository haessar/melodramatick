# Copy this file to .env for local development or deployment-specific settings.

# Generate a unique value for deployed sites. If omitted, Django will generate
# a temporary key each time settings load.
DJANGO_SECRET_KEY=

# These defaults support the README runserver flow. For deployment, set
# DEBUG=False, set DJANGO_SECRET_KEY, and configure DJANGO_ALLOWED_HOSTS.
DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Defaults to DEBUG. Uncomment to run with DEBUG=True but no debug toolbar.
# ENABLE_DEBUG_TOOLBAR=False

# Defaults to SQLite at db.sqlite3 when left blank.
# For MySQL, also install the mysql extra: python -m pip install -e ".[mysql]"
DATABASE_URL=

# Optional integrations.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
RAPID_API_KEY=
