# Copy this file to .env for local development or deployment-specific settings.

# Generate a unique value for deployed sites. If omitted, Django will generate
# a temporary key each time settings load.
DJANGO_SECRET_KEY=

# Set to True for local development.
DEBUG=False
DEVELOPMENT_MODE=False
DJANGO_ALLOWED_HOSTS=

# Defaults to SQLite at db.sqlite3 when left blank.
# For MySQL, also install the mysql extra: python -m pip install -e ".[mysql]"
DATABASE_URL=

# Optional integrations.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
RAPID_API_KEY=
